# Google AI Studio / Gemini API Configuration
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# Active Model on Google AI Studio:
#   - gemini/gemini-3.8-flash (Recommended: State-of-the-Art Intelligence & Speed)
#   - gemini/gemini-3.7-flash (Hybrid Reasoning & High Context)
#   - gemini/gemini-2.5-pro (Complex In-Depth Analytical Reasoning)
#   - gemini/gemini-flash-latest
MODEL_NAME=gemini/gemini-3.8-flash

# Multi-Tier Contextual Memory Configuration
# Enable short-term, long-term, and entity memory across agents
CREW_MEMORY_ENABLED=true

# Embedder provider: 'onnx' (local fast 0-cost), 'google', or 'openai'
EMBEDDER_PROVIDER=onnx

# API security
# Keep empty for localhost-only admin endpoints. Set a strong random token if remote access is required.
APP_API_TOKEN=

# Comma-separated browser origins allowed by the FastAPI CORS middleware.
CORS_ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
